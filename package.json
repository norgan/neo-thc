{
  "name": "neo-thc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev:api": "tsx watch server/main.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.browser-tests.json --noEmit",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && vite build",
    "start": "node dist/server/server/main.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "@playwright/test": "1.64.0"
  }
}
