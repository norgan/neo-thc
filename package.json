{
  "name": "neo-thc",
  "version": "0.2.1",
  "description": "Home tech support, actual playback evidence and scoped network discovery",
  "author": "norgan",
  "main": "desktop/main.cjs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev:api": "tsx watch server/main.ts",
    "dev:web": "vite",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.browser-tests.json --noEmit",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && vite build && node scripts/package-companion.mjs",
    "start": "node dist/server/server/main.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "test:browser": "playwright test",
    "desktop": "electron .",
    "setup:dns-bench": "node scripts/setup-dns-bench.mjs",
    "package:desktop": "node scripts/setup-dns-bench.mjs --windows-x64 && electron-builder --win portable nsis --x64 --publish never",
    "start:service": "node dist/server/server/service.js",
    "package:service": "node scripts/setup-dns-bench.mjs && node scripts/package-service.mjs"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "fflate": "0.8.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "overrides": {"global-agent": "4.1.3"},
  "build": {
    "appId": "net.norgan.neo-thc",
    "productName": "NEO THC",
    "asar": false,
    "compression": "store",
    "directories": {"output": "release"},
    "files": ["desktop/**/*", "dist/**/*", "browser-companion/**/*", "tools/dns-bench/**/*", "package.json"],
    "win": {"signExecutable": false, "artifactName": "NEO-THC-${version}-${arch}-Setup.${ext}"},
    "portable": {"artifactName": "NEO-THC-${version}-${arch}-Portable.${ext}"},
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true}
  }
}
