{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist/server",
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "tests/**/*.ts"]
}
